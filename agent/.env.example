GEMINI_API_KEY=your-free-api-key-from-aistudio.google.com/apikey
GEMINI_MODEL=gemini-3.6-flash

# Optional: set AI_PROVIDER=claude to use Anthropic instead of Gemini (needs
# ANTHROPIC_API_KEY from https://console.anthropic.com/settings/keys). Paid,
# but far more reliable for multi-step tool use than Gemini's free tier.
AI_PROVIDER=gemini
ANTHROPIC_API_KEY=your-key-from-console.anthropic.com/settings/keys
ANTHROPIC_MODEL=claude-sonnet-5

# OpenAI: AI_PROVIDER=openai for the REPL; test:robot always uses OpenAI.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
# Set false to watch the robot in a visible browser.
BROWSER_HEADLESS=true

# Optional MCP servers: copy mcp.example.json to mcp.json. MCP_CONFIG overrides
# the path. Put tokens referenced as ${VAR} in mcp.json here, e.g.:
# GITHUB_TOKEN=
